# Maintainer: AstralSightStudios <dev@astralsight.studio>
# 使用预编译二进制文件打包（跳过编译）

pkgname=astrobox-ng
pkgver=2.2.0
pkgrel=1
pkgdesc="AstroBox is a leading tool for managing and extending wearable devices"
arch=('x86_64')
url="https://github.com/AstralSightStudios/AstroBox-NG"
license=('AGPL-3.0')
options=('!debug')
depends=(
    # CEF（Chromium）运行时
    'nss'
    'nspr'
    'alsa-lib'
    'libcups'
    'mesa'
    'at-spi2-core'
    'libx11'
    'libxcb'
    'libxext'
    'libxfixes'
    'libxdamage'
    'libxcomposite'
    'libxrandr'
    'libxkbcommon'
    'pango'
    'cairo'
    'gdk-pixbuf2'
    'expat'
    # 应用本身（GTK 文件对话框、蓝牙、单实例）
    'gtk3'
    'glib2'
    'dbus'
    'systemd-libs'
    'gcc-libs'
    'glibc'
    'hicolor-icon-theme'
    'desktop-file-utils'
    'shared-mime-info'
)
optdepends=(
    'sqlite: migrate settings and sign-in state from WebKitGTK-based releases'
)
source=()
sha256sums=()

# 使用预编译的二进制文件路径（通过环境变量传入）
PREBUILT_DIR="${PREBUILT_DIR:-}"

package() {
    if [ -z "$PREBUILT_DIR" ]; then
        echo "错误：需要设置 PREBUILT_DIR 环境变量指向预编译目录"
        echo "用法：PREBUILT_DIR=/path/to/release makepkg"
        exit 1
    fi
    
    # Binary
    install -Dm755 "$PREBUILT_DIR/AstroBox-ng" "$pkgdir/usr/bin/AstroBox-ng"

    # CEF（Chromium）运行时：二进制的 rpath 指向 /usr/lib/AstroBox-ng
    install -dm755 "$pkgdir/usr/lib/AstroBox-ng"
    cp -r --no-preserve=ownership "$PREBUILT_DIR/../cef-runtime/." "$pkgdir/usr/lib/AstroBox-ng/"
    
    # Desktop file
    local desktop_src
    desktop_src=$(find "$PREBUILT_DIR/bundle" -name "AstroBox.desktop" 2>/dev/null | head -1)
    if [ -n "$desktop_src" ] && [ -f "$desktop_src" ]; then
        install -Dm644 "$desktop_src" "$pkgdir/usr/share/applications/AstroBox.desktop"
    else
        install -dm755 "$pkgdir/usr/share/applications"
        cat > "$pkgdir/usr/share/applications/AstroBox.desktop" << 'EOF_DESKTOP'
[Desktop Entry]
Categories=Utility;
Comment=AstroBox - Wearable Device Toolbox
Exec=AstroBox-ng %U
Icon=AstroBox-ng
Name=AstroBox
Terminal=false
Type=Application
MimeType=x-scheme-handler/astrobox;
EOF_DESKTOP
    fi
    
    # Icon
    install -Dm644 "$PREBUILT_DIR/../../modules/app/icons/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/AstroBox-ng.png"
    
    # License
    install -Dm644 "$PREBUILT_DIR/../../../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
